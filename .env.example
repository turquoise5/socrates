# ── Model provider ──────────────────────────────────────────────
# anthropic (default): Claude via Anthropic's API, with built-in calculator
#   and web search tools, prompt caching and refusal fallbacks.
# openai: any OpenAI-compatible API — OpenAI, OpenRouter, Gemini, Groq,
#   Mistral, Together, or a local server (Ollama, LM Studio, vLLM).
PROVIDER=anthropic
API_KEY=sk-ant-...

# Model ID as your provider names it.
# Default for anthropic: claude-opus-5-5 (claude-sonnet-5-5 is cheaper/faster).
# Required for openai.
# MODEL=claude-sonnet-5-5

# openai provider only: the API's base URL (default https://api.openai.com/v1).
# OpenRouter:  https://openrouter.ai/api/v1
# Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
# Ollama:      http://localhost:11434/v1   (no API_KEY needed)
# API_BASE_URL=https://openrouter.ai/api/v1

# openai provider only: cap on output tokens (default: the model's own limit)
# MAX_TOKENS=8000

# anthropic provider only: reasoning effort, low | medium | high (default low)
# EFFORT=low

# ── Accounts ────────────────────────────────────────────────────
# Let more people create accounts after the first one (default: false)
# ALLOW_SIGNUP=true

# Set to true when serving over HTTPS so session cookies are Secure
# COOKIE_SECURE=true
